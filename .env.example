# ============================================================
# Exemplo de variáveis de ambiente — copie para `.env` e ajuste.
#   cp .env.example .env
# NUNCA versione o .env real (ele está no .gitignore).
# ============================================================

# Fuso horário do processo Node
TZ="America/Sao_Paulo"

# Ambiente: development | production
NODE_ENV="development"

# ---- Banco de dados MySQL ----
DB_USER="root"
DB_PASS="root"
DB_NAME="futlsf_dev"
DB_HOST="localhost"
DB_PORT=3306

# Porta em que a API sobe
PORT=3001

# Origens permitidas no CORS (separadas por vírgula).
# ⚠️ Deixar vazio faz o servidor aceitar QUALQUER origem — defina em produção.
FRONTEND_URL=http://localhost:3000,http://localhost:3001,http://localhost:3002

# ---- Segredos JWT ----
# Gere valores fortes (32 bytes em hex) com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="troque-por-uma-chave-aleatoria-de-64-hex"
JWT_EXPIRES_IN="5h"
REFRESH_TOKEN_SECRET="troque-por-outra-chave-aleatoria-de-64-hex"
REFRESH_TOKEN_EXPIRES_IN="7d"

# ---- Supabase Storage (upload de escudos de times) ----
# Crie um projeto em supabase.com → Storage → bucket "team-logos" (público).
# Copie de Project Settings → API.
SUPABASE_URL="https://<projeto>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<service_role_key>"
